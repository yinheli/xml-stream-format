{
  "name": "xml-stream-format",
  "version": "0.1.0",
  "description": "Strict, disk-assisted streaming XML formatter and read-only XPath terminal browser",
  "type": "module",
  "license": "MIT",
  "author": "yinheli",
  "engines": {
    "node": "^22.13.0 || >=23.4.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "imports": {
    "#expat-wasm": {
      "types": "./vendor/expat-wasm/types/index.d.ts",
      "default": "./vendor/expat-wasm/lib/index.js"
    },
    "#fontoxpath": {
      "types": "./vendor/fontoxpath/dist/fontoxpath.d.ts",
      "default": "./vendor/fontoxpath/dist/fontoxpath.js"
    }
  },
  "bin": {
    "xml-stream-format": "./dist/cli/main.js"
  },
  "files": [
    "dist/",
    "vendor/expat-wasm/",
    "vendor/fontoxpath/",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "prepublishOnly": "npm test",
    "build": "tsdown",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "tsc --noEmit && vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "site:dev": "vite site",
    "site:build": "tsc -p site && vite build site",
    "site:preview": "vite preview site"
  },
  "dependencies": {
    "clipboardy": "5.3.2",
    "commander": "15.0.0",
    "fuzzysort": "4.0.2",
    "ink": "8.0.0",
    "prsc": "4.0.0",
    "react": "19.3.1",
    "slimdom": "4.3.5",
    "string-width": "8.3.0",
    "xspattern": "3.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@vitest/coverage-v8": "^5.0.5",
    "buffer": "^6.0.3",
    "events": "^3.3.0",
    "tsdown": "^0.23.1",
    "typescript": "6.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
